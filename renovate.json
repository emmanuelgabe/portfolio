
  {
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "mode": "full",
    "timezone": "Europe/Paris",
    "prConcurrentLimit": 3,
    "prHourlyLimit": 2,
    "labels": ["dependencies"],
    "dependencyDashboard": true,
    "packageRules": [
      {
        "description": "Locally built images, absent from any registry",
        "matchPackageNames": ["portfolio-angular-frontend", "portfolio-spring-backend"],
        "enabled": false
      },
      {
        "description": "Group all Docker image updates into a single PR",
        "matchManagers": ["docker-compose", "dockerfile"],
        "matchUpdateTypes": ["minor", "patch"],
        "groupName": "docker images"
      },
      {
        "description": "Group npm minor and patch updates",
        "matchManagers": ["npm"],
        "matchUpdateTypes": ["minor", "patch"],
        "groupName": "npm dependencies"
      },
      {
        "description": "Group gradle minor and patch updates",
        "matchManagers": ["gradle"],
        "matchUpdateTypes": ["minor", "patch"],
        "groupName": "gradle dependencies"
      },
      {
        "description": "Static analysis tooling, kept out of the library group",
        "matchManagers": ["gradle"],
        "matchPackageNames": ["spotbugs", "checkstyle", "jacoco"],
        "groupName": "gradle build tooling"
      },
      {
        "description": "Group GitHub Actions updates",
        "matchManagers": ["github-actions"],
        "groupName": "github actions"
      },
      {
        "description": "Major updates require manual approval from the dependency dashboard",
        "matchUpdateTypes": ["major"],
        "dependencyDashboardApproval": true
      },
      {
        "description": "Pinned by Angular 19 peer dependencies, upgrade Angular first",
        "matchManagers": ["npm"],
        "matchPackageNames": ["typescript", "zone.js"],
        "enabled": false
      }
    ]
  }
